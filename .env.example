# AfterCredits — Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local to Git!

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-side only (Optional for elevated admin tasks; NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# -----------------------------------------------------------------------------
# TMDB API (The Movie Database)
# -----------------------------------------------------------------------------
# Found in: https://www.themoviedb.org/settings/api
# Used to fetch TV show metadata, seasons, episodes, cast, posters & backdrops
TMDB_API_KEY=your-tmdb-v3-api-key-here
# Or TMDB v4 Bearer Token
TMDB_READ_ACCESS_TOKEN=your-tmdb-v4-read-access-token-here

# -----------------------------------------------------------------------------
# Application URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
